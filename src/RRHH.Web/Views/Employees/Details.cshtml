@model EmployeeDetailsViewModel
@{
    ViewData["Title"] = "Detalle del empleado";
}

<section class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">@Model.Position · @Model.DepartmentName</p>
    </div>
    <span class="badge rounded-pill @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">
        @(Model.IsActive ? "Activo" : "Retirado")
    </span>
</section>

<div class="row">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DocumentNumber)</dt>
                    <dd class="col-sm-8">@Model.DocumentNumber</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DepartmentName)</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Departments" asp-action="Details" asp-route-id="@Model.DepartmentId">@Model.DepartmentName</a>
                        <span class="badge text-bg-light border ms-1">@Model.DepartmentCode</span>
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Position)</dt>
                    <dd class="col-sm-8">@Model.Position</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Salary)</dt>
                    <dd class="col-sm-8">@Model.SalaryTexto</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.HireDate)</dt>
                    <dd class="col-sm-8">@Model.HireDateTexto</dd>

                    @if (!Model.IsActive)
                    {
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TerminationDate)</dt>
                        <dd class="col-sm-8">@Model.TerminationDateTexto</dd>
                    }

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Email)</dt>
                    <dd class="col-sm-8">
                        @if (Model.Email is null)
                        {
                            @("—")
                        }
                        else
                        {
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        }
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Phone)</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Address)</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
                    <dd class="col-sm-8">@Model.CreatedAtTexto</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
                    <dd class="col-sm-8">@Model.UpdatedAtTexto</dd>

                    <dt class="col-sm-4">Identificador</dt>
                    <dd class="col-sm-8 mb-0"><code>@Model.Id</code></dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                @if (Model.IsActive)
                {
                    <a asp-action="Deactivate" asp-route-id="@Model.Id" class="btn btn-outline-danger">Retirar</a>
                }
                else
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success">Reintegrar</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
