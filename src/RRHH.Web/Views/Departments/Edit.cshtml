@model RRHH.Web.ViewModels.Departments.DepartmentFormViewModel
@{
    ViewData["Title"] = "Editar departamento";
}

<section class="mb-4">
    <h1 class="h3 mb-1">Editar departamento</h1>
    <p class="text-muted mb-0">Actualiza los datos de @Model.Name.</p>
</section>

<div class="row">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id">

                    <partial name="_Form" model="Model" />

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
