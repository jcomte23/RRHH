@model Department
@{
    ViewData["Title"] = "Detalle del departamento";
}

<section class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">
            <span class="badge text-bg-secondary align-middle">@Model.Code</span>
            @Model.Name
        </h1>
        <p class="text-muted mb-0">Detalle del departamento.</p>
    </div>
    <span class="badge rounded-pill @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">
        @(Model.IsActive ? "Activo" : "Inactivo")
    </span>
</section>

<div class="row">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Description)</dt>
                    <dd class="col-sm-8 text-muted">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Location)</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Budget)</dt>
                    <dd class="col-sm-8">@(Model.Budget.HasValue ? Model.Budget.Value.ToString("C2") : "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Phone)</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Email)</dt>
                    <dd class="col-sm-8">
                        @if (Model.Email is null)
                        {
                            @("—")
                        }
                        else
                        {
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        }
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
                    <dd class="col-sm-8">
                        @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToLocalTime().ToString("g") : "Sin ediciones")
                    </dd>

                    <dt class="col-sm-4">Identificador</dt>
                    <dd class="col-sm-8 mb-0"><code>@Model.Id</code></dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                @if (Model.IsActive)
                {
                    <a asp-action="Deactivate" asp-route-id="@Model.Id" class="btn btn-outline-danger">Desactivar</a>
                }
                else
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success">Reactivar</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
