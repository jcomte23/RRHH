@model Department
@{
    ViewData["Title"] = "Desactivar departamento";
}

<section class="mb-4">
    <h1 class="h3 mb-1">Desactivar departamento</h1>
    <p class="text-muted mb-0">El registro no se elimina: queda inactivo y se puede reactivar después.</p>
</section>

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <p class="mb-3">
                    ¿Confirmas que deseas desactivar el departamento
                    <strong>@Model.Name</strong> (@Model.Code)?
                </p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Description)</dt>
                    <dd class="col-sm-8 text-muted">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Location)</dt>
                    <dd class="col-sm-8 mb-0">@(Model.Location ?? "—")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-warning">Sí, desactivar</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>
