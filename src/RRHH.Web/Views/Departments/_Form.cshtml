@model DepartmentFormViewModel

<div class="row g-3">
    <div class="col-12 col-sm-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" placeholder="RRHH" maxlength="10">
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Talento Humano" maxlength="60">
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="¿De qué se encarga este departamento?"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12 col-sm-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="Sede Norte - Piso 3" maxlength="80">
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Budget" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Budget" class="form-control" type="number" step="0.01" min="0" placeholder="0.00">
        </div>
        <span asp-validation-for="Budget" class="text-danger small"></span>
    </div>

    <div class="col-12 col-sm-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" placeholder="+57 300 000 0000" maxlength="20">
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" placeholder="area@empresa.com" maxlength="120">
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
</div>
